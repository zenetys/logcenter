#!/bin/bash

PROGNAME=${0##*/}
ES_SCROLL_SIZE=${ES_SCROLL_SIZE:-1000}
ES_SCROLL_TTL=${ES_SCROLL_TTL:-1m}
TMPFILE=

# Keep track of scroll ids to close them on exit
declare -A SCROLL_IDS=()

function exit_usage() {
    local status=${1:-0}
    [[ $status != 0 ]] && exec >&2
    echo "\
Usage: $PROGNAME [OPTION...] INDEX [QUERY] [PARAMS]
Search elasticsearch with a scroll until there is no more hit

Available options:
    -v, --verbose       Be verbose, prints on stderr
    -h, --help          Display this help

This script performs a scroll _search query on the given index.

QUERY is the data to POST for the query in the initial request, it
must be a JSON object, it may be empty. Property size is added to
QUERY unless already set, with a value of $ES_SCROLL_SIZE. The scroll
is kept alive for $ES_SCROLL_TTL, refreshed on each request.

If PARAMS is given, it gets appended to the URL parameters of the
initial search query. Beware a size given there takes precedence over
the size property of QUERY.

Environment variables ES_SCROLL_SIZE and ES_SCROLL_TTL override
the defaults given above."
    exit "$status"
}

function perr() {
    echo "$PROGNAME: $*" >&2
}

function _curl() {
    if [[ -n $VERBOSE ]]; then
        perr "Call es-curl $*"
    fi
    es-curl "$@"
}

function on_exit() {
    local i
    if [[ -n $TMPFILE && -e $TMPFILE ]]; then
        rm ${VERBOSE:+-v} "$TMPFILE" >&2
    fi
    for i in "${!SCROLL_IDS[@]}"; do
        _curl "/_search/scroll" -d "{\"scroll_id\":\"$i\"}" -s -o /dev/null -X DELETE
    done
}

# $1: index
# $2: query to POST
# $3: extra _search parameters
# $4: internal, scroll id
function es-scroll() {
    local index=$1 query=$2 params=$3 scroll_id=$4
    local body meta

    if [[ -n $scroll_id ]]; then
        # continue scroll
        [[ $VERBOSE ]] && perr "Continue scroll $scroll_id"
        _curl "/_search/scroll" -d "{\"scroll\":\"$ES_SCROLL_TTL\",\"scroll_id\":\"$scroll_id\"}" -s -o "$TMPFILE"
    else
        # initial query
        [[ $VERBOSE ]] && perr 'Send initial query'
        body=$(jq -cn --argjson query "${query:-{\}}" --argjson size "$ES_SCROLL_SIZE" '
            $query |(if .size == null then .size = $size else . end)')
        [[ -z $body ]] && { perr "Error, jq failed to build query"; return 1; }
        _curl "$index/_search?scroll=$ES_SCROLL_TTL${params:+&$params}" -d "$body" -s -o "$TMPFILE"
    fi
    [[ $? != 0 ]] && { perr "Error, cURL failed"; return 1; }
    [[ -s $TMPFILE ]] || { perr "Error, empty response"; return 1; }
    meta=($(jq -r '"\(._scroll_id)\n\(.hits.hits |length)"' "$TMPFILE"))
    [[ $? != 0 || ${#meta[@]} != 2 ]] && { perr "Error, jq failed to extract metadata"; return 1; }
    [[ -z ${meta[0]} ]] && { perr "Error, empty scroll id"; return 1; }
    SCROLL_IDS["${meta[0]}"]=1
    cat "$TMPFILE"
    [[ ${meta[1]} == 0 ]] && return 0
    "$FUNCNAME" "$index" "$query" "$params" "${meta[0]}"
}

ARGS=()
while (( $# > 0 )); do
    case "$1" in
        -v|--verbose) VERBOSE=1 ;;
        -h|--help) exit_usage 0 ;;
        --) shift; break ;;
        -*) exit_usage 1 ;;
        *) ARGS+=( "$1" ) ;;
    esac
    shift
done
ARGS+=( "$@" )

[[ -z ${ARGS[0]} ]] && exit_usage 1

trap on_exit EXIT
TMPFILE=$(TMPDIR=${TMPDIR:-/dev/shm} mktemp --suffix ".$PROGNAME")
es-scroll "${ARGS[@]:0:3}"
